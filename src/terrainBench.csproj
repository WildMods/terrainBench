<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NoWarn>CS0436</NoWarn>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    </PropertyGroup>
    
    <PropertyGroup>
        <LibraryPath>$(MSBuildProjectDirectory)/../lib</LibraryPath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(LibraryPath)/SarcLibrary/src/SarcLibrary/SarcLibrary.csproj" Version="1.0.0" />
        <ProjectReference Include="$(LibraryPath)/cs-oead/lib/Native.IO/src/Native.IO.csproj" />
        <ProjectReference Include="$(LibraryPath)/cs-oead/src/CsOead.csproj" />
        <ProjectReference Include="$(LibraryPath)/OperationResult/OperationResult/OperationResult.csproj" />
        <PackageReference Include="OpenTK" Version="4.9.4" />
        <PackageReference Include="SmoothGL" Version="1.2.0" />

        <Content Condition="Exists('../lib/cs-oead/native/build/cs_oead.so')" Include="../lib/cs-oead/native/build/cs_oead.so" Link="Lib/cs_oead.so" TargetPath="cs_oead.so" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
        <Content Condition="Exists('../lib/cs-oead/native/build/cs_oead.dll')" Include="../lib/cs-oead/native/build/cs_oead.dll" Link="Lib/cs_oead.dll" TargetPath="cs_oead.dll" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
        <Content Condition="Exists('../lib/cs-oead/native/build/cs_oead.dylib')" Include="../lib/cs-oead/native/build/cs_oead.dylib" Link="Lib/cs_oead.dylib" TargetPath="cs_oead.dylib" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>



</Project>
